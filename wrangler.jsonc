{
  "name": "saltline-rooms",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SALTLINE_GAME_ORIGIN": "https://amerkallajo.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SaltlineRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SaltlineRoom"] }]
}
